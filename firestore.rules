rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 로그인하지 않아도 볼 수 있는 자료.
    // 02 동아리 활동 · 04 일정 · 행사 홍보 · 05 연합회 행사 · 공지가 여기에 해당한다.
    // 쓰기는 아래에서 여전히 권한을 따진다.
    function isPublicReadable() {
      return true;
    }

    // Keep this in sync with the client-side administrator account check.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'a33272708@gmail.com',
          'khhsexploithub@gmail.com',
          '111@111.com'
        ];
    }

    // Roles, the 3D printer permission and subcommittee memberships all live in
    // /users/{uid} and may only be changed by an administrator.
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function storedRole() {
      return hasProfile() ? profileData().role : 'general';
    }

    function isExecutive() {
      return isAdmin() || (isSignedIn() && storedRole() == 'executive');
    }

    function hasPrinterAccess() {
      return isAdmin() || (hasProfile() && profileData().get('printerAccess', false) == true);
    }

    // 소위원회 소속 (소위원회 임원 + 소위원장). 관리 현황 열람까지만 해당한다.
    function inSubcommittee(name) {
      return hasProfile() && (name in profileData().get('subcommittees', []));
    }

    // 소위원장. 승인 · 반려 등 실제 처리 권한은 여기까지만 준다.
    // subcommitteeChairs 가 없던 시절 계정은 소위원회 임원으로 취급되어 자동으로 제외된다.
    function isSubcommitteeChair(name) {
      return hasProfile() && (name in profileData().get('subcommitteeChairs', []));
    }

    function canReviewBudget() {
      return isAdmin() || isSubcommitteeChair('budget');
    }

    function canReviewResource() {
      return isAdmin() || isSubcommitteeChair('resource');
    }

    // 일정 관리와 행사 홍보, 연합회 행사는 행사운영 소위원장이 맡는다.
    function canManageEvent() {
      return isAdmin() || isSubcommitteeChair('event');
    }

    // 소위원장 자리를 하나라도 갖고 있는지.
    function isAnyChair() {
      return hasProfile() && profileData().get('subcommitteeChairs', []).size() > 0;
    }

    // 공지 작성 권한.
    // 관리자이거나, 관리자가 공지 권한을 준 '소위원장' 계정만 쓸 수 있다.
    // 소위원장에서 내려오면 noticeAccess 가 남아 있어도 이 조건에서 걸러진다.
    function canWriteNotice() {
      return isAdmin()
        || (hasProfile() && profileData().get('noticeAccess', false) == true && isAnyChair());
    }

    // 동아리 과제의 제출 기간. 제출글을 만들 때 기간 안인지 확인한다.
    function assignmentData(assignmentId) {
      return get(/databases/$(database)/documents/clubAssignments/$(assignmentId)).data;
    }

    function isWithinAssignmentPeriod(assignmentId) {
      return request.time.toMillis() >= assignmentData(assignmentId).get('startAt', 0)
        && request.time.toMillis() <= assignmentData(assignmentId).get('dueAt', 0);
    }

    // 제출글을 고칠 수 있는 때. 제출 기간 안이거나, 과제가 '마감 후 수정 허용'이면 마감 뒤에도.
    function canEditSubmissionNow(assignmentId) {
      return request.time.toMillis() >= assignmentData(assignmentId).get('startAt', 0)
        && (request.time.toMillis() <= assignmentData(assignmentId).get('dueAt', 0)
          || assignmentData(assignmentId).get('allowLateEdit', false) == true);
    }

    // 과제 문서에 담기는 내용이 올바른지. 작성자 · 관리자의 수정에서 쓴다.
    // 첨부파일은 Storage 에 올리고 이름과 주소만 담으며, 최대 10개까지다.
    // (파일 하나당 30MB 는 storage.rules 에서 막는다)
    function validAssignmentContent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.managerName is string
        && data.target is string
        && data.startAt is number
        && data.dueAt is number
        && data.dueAt > data.startAt
        && data.allowLateEdit is bool
        && data.allowComment is bool
        && data.notice is string
        && data.notice.size() <= 10000
        && data.get('attachments', []) is list
        && data.get('attachments', []).size() <= 10;
    }

    // ---- 소속 동아리 ----
    // 계정에 저장된 소속 동아리. 한 곳만 담기지만 목록 형태로 둔다.
    function myClubs() {
      return hasProfile() ? profileData().get('clubs', []) : [];
    }

    // 이 계정이 부장인 동아리. 없으면 빈 문자열.
    function myLeaderClub() {
      return hasProfile() ? profileData().get('clubLeaderOf', '') : '';
    }

    // 과제 문서에 동아리가 없던 시절 기록은 연합회 공통으로 본다.
    function assignmentClubOf(data) {
      return data.get('clubName', '연합회 공통');
    }

    // 이 동아리 과제를 볼 수 있는지. 연합회 공통은 모두가 본다.
    function canSeeClub(clubName) {
      return isAdmin()
        || clubName == '연합회 공통'
        || (isSignedIn() && (clubName in myClubs()));
    }

    function canSeeAssignment(assignmentId) {
      return canSeeClub(assignmentClubOf(assignmentData(assignmentId)));
    }

    // 과제를 등록한 계정. 제출 현황 전체와 낸 내용까지 볼 수 있다.
    function isAssignmentManager(assignmentId) {
      return isSignedIn()
        && assignmentData(assignmentId).get('authorUid', '') == request.auth.uid;
    }

    // 지금 읽고 있는 과제 문서를 내가 등록했는지. (과제 문서 자체의 규칙에서 쓴다)
    function isOwnAssignment() {
      return isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid;
    }

    // 이 과제에 이미 제출한 계정. 제출글은 계정 uid 를 문서 번호로 쓴다.
    function hasSubmitted(assignmentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clubAssignments/$(assignmentId)/submissions/$(request.auth.uid));
    }

    // 예산 신청 비밀번호. 관리자만 정할 수 있고, 규칙 안에서만 꺼내 쓴다.
    function requestPasswordHash() {
      return get(/databases/$(database)/documents/settings/budgetRequest).data.passwordHash;
    }

    function hasRequestPassword() {
      return exists(/databases/$(database)/documents/settings/budgetRequest);
    }

    // ---- 긴급 예산 신청 (src/budget/budgetPolicy.js 와 숫자를 맞춘다) ----
    // 동아리마다 한 달에 한 번. 달은 서버 시각(UTC) 기준 "2026-10" 모양.
    function urgentMonthKey() {
      return string(request.time.year()) + '-' + string(request.time.month());
    }

    function urgentUsagePath(clubName) {
      return /databases/$(database)/documents/budgetUrgentUsage/$(clubName + '_' + urgentMonthKey());
    }

    // 긴급 신청서를 새로 낼 때의 조건
    //  - 총액 10만 원 이하 · 사유 20~500자 · 필요한 날짜(YYYY-MM-DD)
    //  - 이번 달 사용 기록이 없어야 하고, 같은 일괄 쓰기에서 기록을 만들어야 한다
    function isValidUrgentCreate(requestId) {
      let data = request.resource.data;
      return data.amount <= 100000
        && data.urgentReason is string
        && data.urgentReason.size() >= 20
        && data.urgentReason.size() <= 500
        && data.neededBy is string
        && data.neededBy.size() == 10
        && !exists(urgentUsagePath(data.clubName))
        && existsAfter(urgentUsagePath(data.clubName))
        && getAfter(urgentUsagePath(data.clubName)).data.requestId == requestId;
    }

    // 긴급 신청은 신청한 본인과 그 동아리 부장이 직접 승인할 수 없다. (반려는 할 수 있다)
    function hasNoConflict(data) {
      return data.requesterUid != request.auth.uid
        && data.clubName != myLeaderClub();
    }

    // ---- 예산 심사 비밀번호 (예산관리소위원회 공통) ----
    // 해시는 settings/budgetReview 에 있고, 그 문서는 아무도 직접 읽을 수 없다. (규칙 안에서만 대조)
    // 관리자가 아직 바꾸지 않았으면 처음 비밀번호의 해시를 쓴다.
    function budgetReviewSettingsPath() {
      return /databases/$(database)/documents/settings/budgetReview;
    }

    function isBudgetReviewPassword(hash) {
      return (exists(budgetReviewSettingsPath())
          && get(budgetReviewSettingsPath()).data.passwordHash == hash)
        || (!exists(budgetReviewSettingsPath())
          && hash == 'a839820146cb613f20ef289c6ea15fed8bea5dfaaf3c7e93f8ec1cf821b25e51');
    }

    function budgetReviewSessionPath() {
      return /databases/$(database)/documents/budgetReviewSessions/$(request.auth.uid);
    }

    // 심사 비밀번호를 넣고 '심사 시작'을 한 지 12시간이 안 지났는지.
    // 비밀번호가 바뀌면 이전 세션은 바로 무효가 된다.
    function hasBudgetReviewSession() {
      return exists(budgetReviewSessionPath())
        && get(budgetReviewSessionPath()).data.expiresAt > request.time
        && isBudgetReviewPassword(get(budgetReviewSessionPath()).data.passwordHash);
    }

    match /settings/{settingId} {
      // 예산 신청 페이지에서 비밀번호를 대조해야 하므로,
      // 신청할 수 있는 계정(로그인한 구성원)까지 읽을 수 있다.
      // 심사 비밀번호(budgetReview)는 예외 — 아무도 읽을 수 없고 규칙 안에서만 대조한다.
      allow get: if isSignedIn() && hasProfile() && settingId != 'budgetReview';
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Account profiles. Everyone signs up as 'general'; only an administrator
    // can promote an account to 'executive'.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'studentId', 'name', 'clubs', 'role', 'createdAt'
        ])
        // 소속 동아리는 가입할 때 한 곳을 고른다.
        && request.resource.data.get('clubs', []) is list
        && request.resource.data.get('clubs', []).size() >= 1
        && request.resource.data.email is string
        && request.resource.data.role == 'general'
        && request.resource.data.createdAt == request.time
        // 학번은 숫자 다섯 자리. 예전 계정을 위해 빈 값도 받아 둔다.
        && request.resource.data.get('studentId', '') is string
        && (request.resource.data.get('studentId', '') == ''
          || request.resource.data.get('studentId', '').matches('[0-9]{5}'))
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 20;

      // Authentication 계정을 지워도 이 권한 기록은 남는다.
      // 관리자가 남은 기록을 직접 정리할 수 있게 삭제를 허용한다.
      // (브라우저에서는 Authentication 계정 자체를 지울 수 없다.)
      allow delete: if isAdmin() && request.auth.uid != userId;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'printerAccess', 'noticeAccess', 'studentId', 'name',
          'clubs', 'clubLeaderOf',
          'subcommittees', 'subcommitteeChairs', 'updatedAt'
        ])
        && request.resource.data.get('clubs', []) is list
        // 부장은 반드시 그 동아리 소속이어야 한다.
        && (request.resource.data.get('clubLeaderOf', '') == ''
          || (request.resource.data.get('clubLeaderOf', '')
            in request.resource.data.get('clubs', [])))
        && request.resource.data.role in ['general', 'executive']
        && request.resource.data.get('printerAccess', false) is bool
        && request.resource.data.get('noticeAccess', false) is bool
        && request.resource.data.get('subcommittees', []) is list
        && request.resource.data.get('subcommitteeChairs', []) is list
        // 소위원장은 반드시 그 소위원회 소속이어야 한다.
        && request.resource.data.get('subcommitteeChairs', [])
          .hasOnly(request.resource.data.get('subcommittees', []))
        // 공지 작성 권한은 소위원장에게만 줄 수 있다.
        && (request.resource.data.get('noticeAccess', false) == false
          || request.resource.data.get('subcommitteeChairs', []).size() > 0);

      // 소속 동아리도 비어 있을 때 본인이 한 번만 채울 수 있다.
      // 한 번 저장되고 나면 관리자만 고칠 수 있다.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clubs', 'updatedAt'])
        && resource.data.get('clubs', []).size() == 0
        && request.resource.data.clubs is list
        && request.resource.data.clubs.size() == 1
        && request.resource.data.clubs[0] is string;

      // 학번과 이름은 비어 있을 때 본인이 한 번만 채울 수 있다.
      // 한 번 저장되고 나면 관리자만 고칠 수 있다.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['studentId', 'name', 'updatedAt'])
        && resource.data.get('studentId', '') == ''
        && resource.data.get('name', '') == ''
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches('[0-9]{5}')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20;

      // 권한을 누가 언제 바꿨는지 남기는 기록. 관리자만 읽고 쓴다.
      match /changeLog/{logId} {
        allow read: if isAdmin();

        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'byEmail', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.byEmail is string
          && request.resource.data.createdAt == request.time;
      }

      // 항목별로 마지막에 읽은 시각. 본인만 읽고 쓴다.
      match /readState/{sectionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;

        allow write: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
      }

      // 푸시 알림 토큰. 기기마다 하나. 본인만 등록 · 삭제한다.
      // 발송은 Cloud Functions(관리자 권한)가 하므로 규칙의 영향을 받지 않는다.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 40
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /budgetRequests/{requestId} {
      // 연합회 임원은 전체 예산 현황과 최근 기록을 본다.
      // 일반 계정은 본인이 낸 신청만 읽을 수 있다.
      // (본인 신청만 읽으려면 requesterUid 로 걸러 질의해야 한다.)
      // 예산 관리 소위원회는 관리자 화면에서 전체 신청을 확인한다.
      allow get, list: if isExecutive()
        || inSubcommittee('budget')
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid);

      // 한 신청서에 물품 여러 개를 담는다. 신청 비밀번호는 해시로만 오간다.
      // 동아리 부장(과 관리자)만 낼 수 있고, 신청 비밀번호로 한 번 더 거른다.
      allow create: if isSignedIn() && hasProfile()
        && (isAdmin() || myLeaderClub() != '')
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'requesterName', 'clubName', 'items', 'amount',
          'requestPasswordHash', 'status', 'adminMemo', 'createdAt', 'reviewedAt',
          'requestType', 'meetingDate', 'urgentReason', 'neededBy'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterName is string
        && request.resource.data.clubName is string
        // 부장은 자기 동아리 이름으로만 낼 수 있다. (다른 동아리 이름으로 긴급 횟수를 피하지 못하게)
        && (isAdmin() || request.resource.data.clubName == myLeaderClub())
        // 일반 = 토요일 회의 심의 · 긴급 = 아래 규칙을 지켜야 한다
        && request.resource.data.get('requestType', 'normal') in ['normal', 'urgent']
        && (request.resource.data.get('requestType', 'normal') == 'normal'
          || isValidUrgentCreate(requestId))
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.adminMemo == ''
        && request.resource.data.reviewedAt == null
        // 관리자가 정해 둔 신청 비밀번호를 아는 계정만 신청할 수 있다.
        && hasRequestPassword()
        && request.resource.data.requestPasswordHash == requestPasswordHash();

      // 예산 관리 소위원장과 관리자가 심사한다.
      // 품목별로 승인 · 반려할 수 있어 items 도 함께 고칠 수 있다.
      allow update: if canReviewBudget()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminMemo', 'reviewedAt', 'items', 'reviewedBy', 'reviewedByName'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() == resource.data.items.size()
        && request.resource.data.status in [
          'pending', 'approved', 'partial', 'rejected', 'confirmed', 'completed', 'assembly'
        ]
        // 흐름: 신청 → 승인 → 연합회장 확인 → 처리 → 처리 완료
        // '연합회장 확인(confirmed)'으로 바꾸는 것은 아래 관리자 전용 규칙으로만 할 수 있다.
        // 여기서는 이미 확인된 건의 상태를 그대로 두는 것(반려 사유 고치기 등)만 허용한다.
        && (request.resource.data.status != 'confirmed' || resource.data.status == 'confirmed')
        // 처리 완료는 연합회장 확인을 거친 건만 할 수 있고, 처리 완료로 바꿀 때 품목은 건드릴 수 없다.
        && (request.resource.data.status != 'completed'
          || resource.data.status == 'completed'
          || (resource.data.status == 'confirmed'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['items'])))
        && request.resource.data.adminMemo is string
        && request.resource.data.reviewedAt == request.time
        // 처리한 사람은 본인 uid 로만 남길 수 있다.
        && request.resource.data.get('reviewedBy', request.auth.uid) == request.auth.uid
        // 심사 비밀번호를 넣고 심사를 시작한 사람만 처리할 수 있다.
        && hasBudgetReviewSession()
        // 긴급 신청: 이해관계가 없는 사람이 승인하고, 승인할 때는 사유(5자 이상)를 남긴다.
        //            자기 동아리 건은 품목을 건드리지 않는 '반려'만 할 수 있다.
        && (resource.data.get('requestType', 'normal') != 'urgent'
          || (hasNoConflict(resource.data)
            && (!(request.resource.data.status in ['approved', 'partial'])
              || request.resource.data.adminMemo.size() >= 5))
          || (request.resource.data.status == 'rejected'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['items'])));

      // [연합회장 확인] — 관리자(연합회장) 계정만 할 수 있다.
      //  - 승인 · 부분 승인 된 건만 '연합회장 확인 완료(confirmed)'로 바꿀 수 있다.
      //  - 상태 · 확인 기록 · 처리 시각 말고는 아무것도 바꿀 수 없다. (품목 · 금액 · 의견 그대로)
      //  - 다른 처리와 같이 심사 비밀번호로 심사를 시작해야 하고,
      //    긴급 신청은 본인 · 자기 동아리 건을 확인할 수 없다.
      allow update: if isAdmin()
        && hasBudgetReviewSession()
        && resource.data.status in ['approved', 'partial']
        && request.resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt',
          'presidentConfirmedAt', 'presidentConfirmedBy', 'presidentConfirmedByName'
        ])
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.presidentConfirmedAt == request.time
        && request.resource.data.presidentConfirmedBy == request.auth.uid
        && request.resource.data.presidentConfirmedByName is string
        && request.resource.data.presidentConfirmedByName.size() <= 40
        && (resource.data.get('requestType', 'normal') != 'urgent'
          || hasNoConflict(resource.data));
    }

    // 심사 세션. '심사 시작'에서 비밀번호가 맞을 때만 만들어진다. 12시간 동안 유지.
    match /budgetReviewSessions/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;

      allow create, update: if isSignedIn() && request.auth.uid == uid
        && canReviewBudget()
        && request.resource.data.keys().hasOnly(['passwordHash', 'expiresAt', 'createdAt'])
        && request.resource.data.passwordHash is string
        && isBudgetReviewPassword(request.resource.data.passwordHash)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(12, 'h');

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 긴급 신청 사용 기록. 문서 번호 = "동아리명_2026-10". 한 달에 하나만 만들 수 있다.
    // 반려돼도 지우지 않는다 (횟수는 쓴 것으로 본다). 관리자만 지워서 되돌릴 수 있다.
    match /budgetUrgentUsage/{usageId} {
      allow get: if isSignedIn();
      allow list: if canReviewBudget() || inSubcommittee('budget');

      allow create: if isSignedIn() && hasProfile()
        && request.resource.data.keys().hasOnly([
          'clubName', 'monthKey', 'requestId', 'requesterUid', 'createdAt'
        ])
        && (isAdmin() || request.resource.data.clubName == myLeaderClub())
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.monthKey == urgentMonthKey()
        && usageId == request.resource.data.clubName + '_' + urgentMonthKey()
        && getAfter(/databases/$(database)/documents/budgetRequests/$(request.resource.data.requestId)).data.get('requestType', 'normal') == 'urgent'
        && getAfter(/databases/$(database)/documents/budgetRequests/$(request.resource.data.requestId)).data.clubName == request.resource.data.clubName;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // 신청 항목별 자동승인 설정. 관리자만 바꿀 수 있고(settings 규칙), 여기서는 읽기만 한다.
    // 문서가 없거나 항목이 꺼져 있으면 모든 신청은 관리자 승인 대기로 시작한다.
    // 설정을 바꿔도 이미 접수된 신청은 그대로이고, 그 뒤의 신규 신청부터 적용된다.
    function reservationAutoApprovalOn(resourceName) {
      return exists(/databases/$(database)/documents/settings/reservationAutoApproval)
        && get(/databases/$(database)/documents/settings/reservationAutoApproval)
          .data.get('items', {}).get(resourceName, false) == true;
    }

    match /resourceReservations/{docId} {
      // 시간이 겹치는 예약을 막으려면 예약 현황을 모두 볼 수 있어야 한다.
      allow read: if isSignedIn();

      // 로그인한 계정이면 누구나 예약을 신청할 수 있다.
      // 다만 3D 프린터는 교육을 이수한 계정만 예약할 수 있다. (이 조건은 그대로 유지)
      //
      // 승인 상태는 클라이언트가 정하지 못한다.
      //  - 신청은 언제나 대기(pending)이고 처리 기록은 비어 있어야 한다.
      //  - 관리자가 그 항목의 자동승인을 켜 둔 경우에만 autoApproveScheduled 를 켤 수 있고,
      //    그런 신청은 접수 시각(createdAt) + 5분이 지나면 아래 규칙으로 승인된다.
      allow create: if isSignedIn() && hasProfile()
        && request.resource.data.keys().hasOnly([
          'clubName', 'requesterName', 'category', 'resourceName', 'date',
          'startTime', 'endTime', 'purpose', 'status', 'adminMemo', 'reviewedAt',
          'autoApproved', 'autoApproveScheduled', 'uid', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.resourceName is string
        && (request.resource.data.resourceName != '3D 프린터' || hasPrinterAccess())
        && request.resource.data.get('adminMemo', '') == ''
        && request.resource.data.status == 'pending'
        && request.resource.data.get('reviewedAt', null) == null
        && request.resource.data.get('autoApproved', false) == false
        && (request.resource.data.get('autoApproveScheduled', false) == false
          || (request.resource.data.autoApproveScheduled == true
            && reservationAutoApprovalOn(request.resource.data.resourceName)));

      // 승인 · 반려는 공간·자원 배정 소위원장만. 본인은 상태를 고칠 수 없다.
      allow update: if canReviewResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminMemo', 'reviewedAt'
        ])
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'completed'];

      // 자동승인: 자동승인 대기 신청이 접수 시각 + 5분을 넘기면, 로그인한 누구든
      // '승인(autoApproved)'으로만 바꿀 수 있다. 시각은 서버 시각으로 확인한다.
      // (예약 화면 · 관리자 화면을 연 브라우저와 Cloud Functions 예약 작업이 바꾼다)
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && resource.data.get('autoApproveScheduled', false) == true
        && request.time >= resource.data.createdAt + duration.value(5, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'autoApproved', 'reviewedAt'
        ])
        && request.resource.data.status == 'approved'
        && request.resource.data.autoApproved == true
        && request.resource.data.reviewedAt == request.time;

      // 본인이 낸 예약은 승인 전까지 본인이 취소할 수 있다.
      // 자동승인으로 확정된 예약도 본인이 취소할 수 있다. (처리자가 따로 없으므로)
      allow delete: if canReviewResource()
        || (isSignedIn()
          && resource.data.uid == request.auth.uid
          && (resource.data.status == 'pending'
            || (resource.data.status == 'approved'
              && resource.data.get('autoApproved', false) == true)));
    }

    match /activityRecords/{activityRecordId} {
      // 동아리 공지는 로그인하지 않아도 읽을 수 있다. (02 열람)
      allow get, list: if isPublicReadable();

      allow create: if isExecutive()
        && request.resource.data.keys().hasOnly([
          'clubName', 'title', 'content', 'passwordHash', 'passwordSalt',
          'authorUid', 'authorName', 'viewCount', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.clubName is string
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordSalt is string
        && request.resource.data.viewCount == 0
        && request.resource.data.createdAt == request.time;

      // Opening a record raises its view count by exactly one. The client only
      // does this once every 30 minutes per account (see /views below).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

      // Administrators may correct the stored content.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clubName', 'title', 'content'
        ])
        && request.resource.data.clubName is string
        && request.resource.data.title is string
        && request.resource.data.content is string;

      // 글을 올린 계정 본인만 지운다. 저장된 비밀번호는 브라우저에서 먼저 대조하고,
      // 규칙은 삭제 요청의 본문을 볼 수 없으므로 작성자 계정까지만 확인한다.
      // 작성자 계정이 없던 시절 글은 관리자 화면에서 정리한다.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid);

      // Per-account view stamps used for the 30 minute view-count cooldown.
      match /views/{userId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // 의견은 누구나 읽을 수 있고, 남기는 것은 로그인한 구성원만 할 수 있다.
      match /comments/{commentId} {
        allow get, list: if isPublicReadable();

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'content', 'authorUid', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // 동아리 과제(02). 과제는 연합회 임원이 열고, 제출글은 로그인한 구성원이 올린다.
    match /clubAssignments/{assignmentId} {
      // 과제는 소속 동아리와 연합회 공통만 읽는다.
      // list 는 문서마다 따지지 못하므로, 화면에서 clubName 조건을 걸어 요청한다.
      allow get: if canSeeClub(assignmentClubOf(resource.data));
      allow list: if canSeeClub(assignmentClubOf(resource.data));

      // 과제는 그 동아리 부장과 관리자가 연다.
      allow create: if (isAdmin()
          || (isSignedIn() && myLeaderClub() != ''
            && myLeaderClub() == request.resource.data.clubName))
        && request.resource.data.keys().hasOnly([
          'clubName', 'title', 'managerName', 'target', 'startAt', 'dueAt',
          'allowLateEdit', 'allowComment', 'notice', 'attachments',
          'authorUid', 'authorName', 'viewCount', 'createdAt'
        ])
        && request.resource.data.get('attachments', []) is list
        && request.resource.data.get('attachments', []).size() <= 10
        && request.resource.data.clubName is string
        && request.resource.data.clubName.size() > 0
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.managerName is string
        && request.resource.data.target is string
        // 제출 기간은 밀리초 숫자로 담는다.
        && request.resource.data.startAt is number
        && request.resource.data.dueAt is number
        && request.resource.data.dueAt > request.resource.data.startAt
        && request.resource.data.allowLateEdit is bool
        && request.resource.data.allowComment is bool
        && request.resource.data.notice is string
        && request.resource.data.notice.size() <= 10000
        && request.resource.data.viewCount == 0
        && request.resource.data.createdAt == request.time;

      // 과제를 열면 조회수가 정확히 1 오른다. (계정마다 30분에 한 번)
      allow update: if isSignedIn()
        && canSeeClub(assignmentClubOf(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

      // 과제 내용 수정은 작성자(등록자)와 관리자만 한다. (화면 · 서버 모두 같은 조건)
      // 동아리 · 작성자 · 조회수는 여기서 바꿀 수 없다.
      allow update: if (isAdmin() || isOwnAssignment())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'managerName', 'target', 'startAt', 'dueAt',
          'allowLateEdit', 'allowComment', 'notice', 'attachments'
        ])
        && validAssignmentContent(request.resource.data);

      allow delete: if isAdmin() || isOwnAssignment();

      // 조회수 쿨다운에 쓰는 계정별 기록.
      match /views/{userId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // 제출글. 계정당 하나이고, 문서 번호로 계정 uid 를 그대로 쓴다.
      //
      //  목록(제목 · 이름 · 날짜) : 담당자 · 관리자 · 이미 제출한 계정
      //  낸 내용과 첨부          : 담당자 · 관리자 · 글쓴이 본인
      //
      // 아직 내지 않은 계정은 제출 현황 자체를 볼 수 없다.
      match /submissions/{userId} {
        allow get: if isAdmin()
          || isAssignmentManager(assignmentId)
          || (isSignedIn() && request.auth.uid == userId)
          || hasSubmitted(assignmentId);

        allow list: if isAdmin()
          || isAssignmentManager(assignmentId)
          || hasSubmitted(assignmentId);

        // 제출 기간 안에서, 본인 자리에만 낼 수 있다.
        allow create: if isSignedIn() && hasProfile()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'title', 'authorUid', 'authorName', 'studentId',
            'attachmentCount', 'viewCount', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.authorName is string
          && request.resource.data.studentId is string
          && request.resource.data.attachmentCount is int
          && request.resource.data.attachmentCount <= 10
          && request.resource.data.viewCount == 0
          && request.resource.data.createdAt == request.time
          && isWithinAssignmentPeriod(assignmentId)
          // 소속 동아리 과제에만 낼 수 있다.
          && canSeeAssignment(assignmentId);

        // 글을 열면 조회수가 정확히 1 오른다.
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

        // 본인 글 수정: 제목과 첨부 수만. 제출 기간 안(또는 '마감 후 수정 허용' 과제)에서만.
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'attachmentCount', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.attachmentCount is int
          && request.resource.data.attachmentCount <= 10
          && request.resource.data.updatedAt == request.time
          && canEditSubmissionNow(assignmentId)
          && canSeeAssignment(assignmentId);

        // 본인과 담당자, 관리자가 지운다.
        allow delete: if isAdmin()
          || isAssignmentManager(assignmentId)
          || (isSignedIn() && request.auth.uid == userId);

        // 낸 내용과 첨부. 목록보다 좁게 연다.
        match /detail/{detailId} {
          allow get: if isAdmin()
            || isAssignmentManager(assignmentId)
            || (isSignedIn() && request.auth.uid == userId);

          allow create: if isSignedIn()
            && request.auth.uid == userId
            && detailId == 'content'
            && request.resource.data.keys().hasOnly([
              'content', 'attachments', 'createdAt'
            ])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 10000
            // 첨부파일은 Storage 에 올리고, 여기에는 이름과 주소만 담는다.
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 10
            && request.resource.data.createdAt == request.time
            && isWithinAssignmentPeriod(assignmentId)
            && canSeeAssignment(assignmentId);

          // 본인 글 수정: 내용과 첨부만. 조건은 위 제출글 수정과 같다.
          allow update: if isSignedIn()
            && request.auth.uid == userId
            && detailId == 'content'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content', 'attachments', 'updatedAt'
            ])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 10000
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 10
            && request.resource.data.updatedAt == request.time
            && canEditSubmissionNow(assignmentId)
            && canSeeAssignment(assignmentId);

          allow delete: if isAdmin()
            || isAssignmentManager(assignmentId)
            || (isSignedIn() && request.auth.uid == userId);
        }

        match /views/{viewerId} {
          allow read, write: if isSignedIn() && request.auth.uid == viewerId;
        }
      }
    }

    match /clubSchedules/{scheduleId} {
      // 일정은 로그인하지 않아도 읽을 수 있다. (04 열람)
      allow get, list: if isPublicReadable();

      allow create: if isExecutive()
        && request.resource.data.keys().hasOnly([
          'clubName', 'title', 'date', 'startTime', 'endTime', 'location',
          'description', 'notice', 'createdAt', 'createdBy'
        ])
        && request.resource.data.clubName is string
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.location is string
        && request.resource.data.description is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Administrators may edit or remove any registered schedule.
      allow update: if canManageEvent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clubName', 'title', 'date', 'startTime', 'endTime', 'location',
          'description', 'notice'
        ]);

      allow delete: if canManageEvent();
    }

    // 행사 홍보. 교실 예약과 달리 홍보 글 · 계획 · 포스터 · 의견을 함께 담는다.
    match /clubEvents/{eventId} {
      // 행사 홍보는 로그인하지 않아도 읽을 수 있다. (04 열람)
      allow get, list: if isPublicReadable();

      // 등록은 캘린더 페이지에서 연합회 임원이 한다.
      allow create: if isExecutive()
        && request.resource.data.keys().hasOnly([
          'clubName', 'title', 'date', 'startTime', 'endTime', 'location',
          'promotion', 'plan', 'posterImage', 'createdAt', 'createdBy'
        ])
        && request.resource.data.clubName is string
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.location is string
        && request.resource.data.promotion is string
        && request.resource.data.plan is string
        && request.resource.data.posterImage is string
        // 포스터는 브라우저에서 줄여 넣는다. 문서 크기 제한에 걸리지 않게 막아 둔다.
        && request.resource.data.posterImage.size() <= 1000000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // 수정과 삭제는 관리자 화면에서 행사운영 소위원장이 한다.
      allow update: if canManageEvent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clubName', 'title', 'date', 'startTime', 'endTime', 'location',
          'promotion', 'plan', 'posterImage'
        ])
        && request.resource.data.posterImage.size() <= 1000000;

      // 행사운영 소위원장과 관리자만 지울 수 있다.
      allow delete: if canManageEvent();

      // 의견은 누구나 읽을 수 있고, 남기는 것은 로그인한 구성원만 할 수 있다.
      match /comments/{commentId} {
        allow get, list: if isPublicReadable();

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'content', 'authorUid', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // 연합회가 주최하는 행사(05). 동아리가 올리는 clubEvents 와는 별개다.
    // 읽기는 로그인한 모든 계정, 작성 · 수정 · 삭제는 행사운영 소위원장과 관리자만.
    match /unionEvents/{unionEventId} {
      // 연합회 행사는 로그인하지 않아도 읽을 수 있다. (05 열람)
      allow get, list: if isPublicReadable();

      allow create: if canManageEvent()
        && request.resource.data.keys().hasOnly([
          'title', 'date', 'startTime', 'endTime', 'location', 'target',
          'content', 'posterImage', 'authorUid', 'authorName', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.location is string
        && request.resource.data.target is string
        && request.resource.data.content is string
        && request.resource.data.posterImage is string
        // 포스터는 브라우저에서 줄여 넣는다. 문서 크기 제한에 걸리지 않게 막아 둔다.
        && request.resource.data.posterImage.size() <= 1000000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.createdAt == request.time;

      allow update: if canManageEvent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'date', 'startTime', 'endTime', 'location', 'target',
          'content', 'posterImage'
        ])
        && request.resource.data.posterImage.size() <= 1000000;

      allow delete: if canManageEvent();
    }

    // 공지. 상단 종 버튼에서 열리는 알림 메시지다.
    // 읽기는 로그인한 모든 계정, 작성은 관리자와 공지 권한을 받은 소위원장만.
    match /notices/{noticeId} {
      // 공지는 로그인하지 않아도 읽을 수 있다.
      allow get, list: if isPublicReadable();

      allow create: if canWriteNotice()
        && request.resource.data.keys().hasOnly([
          'title', 'content', 'category', 'authorUid', 'authorName', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.category in ['general', 'event', 'urgent']
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.createdAt == request.time;

      allow update: if canWriteNotice()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'content', 'category'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.category in ['general', 'event', 'urgent'];

      allow delete: if canWriteNotice();
    }

    // Keep the existing public application-submission flow working. Applications
    // are write-only for visitors; no current client feature reads or updates them.
    match /applications/{applicationId} {
      allow create: if true;
    }
  }
}
